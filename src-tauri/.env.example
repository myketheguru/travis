# Copy this to src-tauri/.env and fill in your values.
# `.env` itself is gitignored so the token never leaves your machine.
#
# Read at compile time by build.rs — values are baked into the resulting
# binary via option_env!. Restart `npm run tauri dev` after editing.

TRAVIS_TELEMETRY_URL=https://us-central1-your-project.cloudfunctions.net/travisIngest
TRAVIS_TELEMETRY_TOKEN=replace-with-the-token-from-firebase-functions-secrets-set
