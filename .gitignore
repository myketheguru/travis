# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-update
*.local

# Rust build output.
src-tauri/target
src-tauri/Cargo.lock.bak

# fastembed downloads its ONNX model into a cache the first time the
# app starts. ~130MB of weights — not appropriate for the repo. The
# user's machine re-fetches on first launch.
src-tauri/.fastembed_cache

# Travis secrets — OAuth client IDs/secrets, telemetry endpoint + token,
# and any other build-time env vars live here for local dev. CI passes
# these through GitHub Actions secrets instead.
src-tauri/.env

# Tauri updater signing key — this should NEVER live inside the repo.
# Keep it at $HOME/.tauri/travis.key (or similar) and back it up offline.
*.key
!src-tauri/icons/*.key

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code session state
.claude/

# Bundled CPython runtime (v0.18.0+) — fetched at build time
src-tauri/resources/python/

# v0.26.4 — whisper model is fetched at build via scripts/fetch-whisper.mjs.
# ~148 MB; well over GitHub's 100 MB file limit. Do not commit.
src-tauri/resources/whisper/*.bin

# v0.28.26 — piper binary + voice model fetched at build via
# scripts/fetch-piper.mjs. Same reasoning as whisper. Keep the
# folder (via .gitkeep) so the tauri.conf.json bundle glob still
# resolves in dev before predev runs.
src-tauri/resources/piper/*.onnx
src-tauri/resources/piper/*.onnx.json
src-tauri/resources/piper/piper
src-tauri/resources/piper/piper.exe
src-tauri/resources/piper/*.tar.gz
src-tauri/resources/piper/*.zip
src-tauri/resources/piper/espeak-ng-data/
debug-output.txt
